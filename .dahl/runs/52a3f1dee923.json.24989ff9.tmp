nslate-y-0 disabled:pointer-events-none disabled:opacity-50;\n57:   }\n58: \n59:   .input-dark {\n60:     @apply w-full rounded border border-line bg-charcoal px-4 py-3 text-sm text-ivory transition-colors placeholder:text-muted/50 focus:border-gold focus:outline-none;\n61:   }\n62: \n63:   .field-error {\n64:     @apply mt-1.5 text-xs text-danger;\n65:   }\n66: }\n67: \n68: /* Scroll-triggered reveals (see src/components/Reveal.jsx) */\n69: .reveal {\n70:   opacity: 0;\n71:   transform: translateY(24px);\n72:   transition:\n73:     opacity 0.7s ease-out,\n74:     transform 0.7s ease-out;\n75:   will-change: opacity, transform;\n76: }\n77: \n78: .reveal-visible {\n79:   opacity: 1;\n80:   transform: none;\n81: }\n82: \n83: @media (prefers-reduced-motion: reduce) {\n84:   html {\n85:     scroll-behavior: auto;\n86:   }\n87: \n88:   .reveal {\n89:     opacity: 1;\n90:     transform: none;\n91:     transition: none;\n92:   }\n93: }\n94: "
