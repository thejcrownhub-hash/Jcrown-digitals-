      "content": "src/components/Reveal.jsx (lines 1-38 of 38)\n1: import { useEffect, useRef } from 'react'\n2: \n3: /**\n4:  * Fades content up when it scrolls into view (SPEC: 600ms+ ease-out reveals).\n5:  * Wraps children in a div that gets the \"reveal-visible\" class once.\n6:  */\n7: export default function Reveal({ children, className = '', delay = 0 }) {\n8:   const ref = useRef(null)\n9: \n10:   useEffect(() => {\n11:     const el = ref.current\n12:     if (!el) return undefined\n13: \n14:     const io = new IntersectionObserver(\n15:       ([entry]) => {\n16:         if (entry.isIntersecting) {\n17:           el.classList.add('reveal-visible')\n18:           io.disconnect()\n19:         }\n20:       },\n21:       { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }\n22:     )\n23: \n24:     io.observe(el)\n25:     return () => io.disconnect()\n26:   }, [])\n27: \n28:   return (\n29:     <div\n30:       ref={ref}\n31:       className={`reveal ${className}`}\n32:       style={delay ? { transitionDelay: `${delay}ms` } : undefined}\n33:     >\n34:       {children}\n35:     </div>\n36:   )\n37: }\n38: "
