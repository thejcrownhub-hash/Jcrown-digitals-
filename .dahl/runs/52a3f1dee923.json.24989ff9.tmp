      "content": "src/components/Logo.jsx (lines 1-35 of 35)\n1: /**\n2:  * Crown mark used in the navbar, footer and favicon.\n3:  */\n4: export function CrownMark({ className = 'h-7 w-7' }) {\n5:   return (\n6:     <svg\n7:       viewBox=\"0 0 24 24\"\n8:       className={className}\n9:       fill=\"currentColor\"\n10:       aria-hidden=\"true\"\n11:     >\n12:       <path d=\"M3 19h18v-2H3v2zm.5-4L5 7.5l4.3 3.2L12 4.5l2.7 6.2L19 7.5l1.5 7.5h-17z\" />\n13:     </svg>\n14:   )\n15: }\n16: \n17: /**\n18:  * Brand wordmark: gold crown + JCROWN over letter-spaced DIGITALS.\n19:  */\n20: export default function Logo() {\n21:   return (\n22:     <a href=\"#top\" className=\"group flex items-center gap-3\" aria-label=\"JCROWN DIGITALS — back to top\">\n23:       <CrownMark className=\"h-7 w-7 text-gold transition-transform duration-300 group-hover:-translate-y-0.5\" />\n24:       <span className=\"flex flex-col leading-none\">\n25:         <span className=\"font-display text-lg font-semibold tracking-wide text-gold\">\n26:           JCROWN\n27:         </span>\n28:         <span className=\"mt-1 text-[10px] font-medium uppercase tracking-[0.42em] text-muted\">\n29:           Digitals\n30:         </span>\n31:       </span>\n32:     </a>\n33:   )\n34: }\n35: "
