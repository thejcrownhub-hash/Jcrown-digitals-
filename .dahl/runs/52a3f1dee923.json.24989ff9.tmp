book',\n35:     },\n36:     {\n37:       title: 'Free Resources',\n38:       description:\n39:         'Access publications and resources specifically made available for free — no account required.',\n40:       icon: 'gift',\n41:     },\n42:     {\n43:       title: 'New Releases & Updates',\n44:       description:\n45:         'Stay informed about new books, resources, and other updates from JCROWN DIGITALS.',\n46:       icon: 'sparkles',\n47:     },\n48:   ],\n49: }\n50: \n51: export const books = {\n52:   title: 'Explore & Download My Books',\n53:   description:\n54:     'Discover the publications available through JCROWN DIGITALS. Choose a book to view its details and access the available download.',\n55: }\n56: \n57: export const newsletter = {\n58:   title: 'Stay Connected with JCROWN DIGITALS',\n59:   description:\n60:     'Get updates when new books, publications, and resources become available.',\n61: }\n62: \n63: export const contact = {\n64:   title: 'Contact Jediah',\n65:   description: 'Have a question or want to get in touch? Send me a message.',\n66:   email: '', // e.g. 'hello@jcrowndigitals.com' — shown in the contact panel when set\n67: }\n68: \n69: export const socials = [\n70:   // { name: 'Instagram', url: 'https://instagram.com/...' },\n71:   // { name: 'Twitter', url: 'https://x.com/...' },\n72:   // { name: 'LinkedIn', url: 'https://linkedin.com/in/...' },\n73:   // { name: 'Facebook', url: 'https://facebook.com/...' },\n74: ]\n75: ",
