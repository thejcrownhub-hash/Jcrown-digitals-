# ---------------------------------------------------------------
# JCROWN DIGITALS — Supabase credentials
# Copy this file to ".env" and fill in your values, found in:
# Supabase Dashboard -> Project Settings -> API
# ---------------------------------------------------------------

# e.g. https://abcdefghij.supabase.co
VITE_SUPABASE_URL=your-project-url

# The "anon / public" key (safe to use in the browser with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------
# Admin portal password (used for the client-side admin login gate)
# Set your own strong password before deploying.
# ---------------------------------------------------------------
VITE_ADMIN_PASSWORD=jcrown-admin
